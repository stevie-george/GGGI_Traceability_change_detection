__pycache__/
*.pyc
.env
*.egg-info/
.ipynb_checkpoints/
assets/tmp/
.streamlit/secrets.toml

# ---- COBIOCOM LULC: datos y artefactos pesados (viven en SSD/disco, no en git) ----
# Tiles Sentinel-2 (junction al SSD), caché de escenas
cobiocom_lulc/out/
cobiocom_lulc/out
# Salidas de inferencia y mosaicos
cobiocom_lulc/maps/
cobiocom_lulc/mosaics/
# Modelos versionados + tablas (grandes; respaldo en disco)
cobiocom_lulc/entrenamientos/
cobiocom_lulc/*.parquet
cobiocom_lulc/*.pkl
cobiocom_lulc/rf_confusion.png
cobiocom_lulc/rf_importances.png
cobiocom_lulc/maps/preview_rf.png
# Proyecto QGIS / renders grandes
cobiocom_lulc/*.qgz
cobiocom_lulc/*.tif
# Validación: respaldos pesados (los CSV chicos sí se versionan)
cobiocom_lulc/validation/_viejo/
cobiocom_lulc/validation/*.gpkg
# Paquetes a consultores (bundles + zips, grandes)
cobiocom_labeling_*/
cobiocom_labeling_*.zip

# ---- Salidas por versión/estado-año + COGs de plataforma (regenerables, pesados) ----
# maps/ y out/ ya están arriba; esto cubre las variantes por versión y por estado
cobiocom_lulc/maps_*/
cobiocom_lulc/out_*/
cobiocom_lulc/plataforma/
cobiocom_lulc/upload/
# Entregables / binarios pesados (renders, presentaciones, zips, gpkg sueltos)
cobiocom_lulc/*.png
cobiocom_lulc/*.pptx
cobiocom_lulc/*.zip
cobiocom_lulc/*.gpkg
# el set de etiquetas de referencia SI se versiona (comentario en su propia linea)
!cobiocom_lulc/labels_merged.gpkg
# Scripts scratch / diagnosticos de una sola vez (prefijo _)
cobiocom_lulc/_*
