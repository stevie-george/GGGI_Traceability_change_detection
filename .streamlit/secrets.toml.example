# Plantilla de .streamlit/secrets.toml  (COPIA este archivo a secrets.toml y rellena
# los valores). El archivo real `secrets.toml` ESTÁ gitignored -> nunca se commitea.
#
# La app (modules/gee_analysis.py -> initialize_gee) lee:
#   st.secrets["gee"]["project"]
#   st.secrets["earthengine"]["service_account"]   # correo del SA
#   st.secrets["earthengine"]["credentials"]        # JSON completo de la llave del SA
# y hace:  ee.ServiceAccountCredentials(service_account, key_data=credentials)
#                                       ee.Initialize(credentials, project=project)

[gee]
project = "lulcc-traceability-mx40"

[earthengine]
# Correo del service account (termina en @lulcc-traceability-mx40.iam.gserviceaccount.com)
service_account = "REEMPLAZA@lulcc-traceability-mx40.iam.gserviceaccount.com"

# Contenido COMPLETO del archivo JSON de la llave del SA, tal cual, entre comillas
# triples simples (literal, no interpreta los \n ni las comillas internas del JSON).
credentials = '''
{
  "type": "service_account",
  "project_id": "lulcc-traceability-mx40",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "REEMPLAZA@lulcc-traceability-mx40.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "..."
}
'''
